{
  "name": "lineless",
  "version": "1.0.0",
  "description": "LineLess - Join the Queue. Skip the Wait. Real-time virtual queue management SaaS.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test tests/unit tests/integration tests/infra tests/websocket",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "test:infra": "node --test tests/infra",
    "test:websocket": "node --test tests/websocket",
    "lint": "eslint backend frontend tests scripts",
    "check": "node scripts/static-checks.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/dev-server.js",
    "deploy": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "destroy": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/destroy.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.700.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "eslint": "^9.17.0",
    "js-yaml": "^4.1.0"
  }
}
