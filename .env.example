# LineLess environment template — copy to .env for local tooling only.
# NEVER commit a real .env. The deployed app receives configuration from
# CloudFormation outputs, never from this file.

# Local dev server port
DEV_PORT=5173

# Local backend URL (only used by scripts/dev-server.js proxy, optional)
# LOCAL_API_URL=http://localhost:3000

# AWS profile for deploy scripts (optional; AWS CLI auth is used as-is)
# AWS_PROFILE=default

# CloudFormation stack name used by deploy scripts
LINELESS_STACK=lineless-dev

# SES sender identity (optional, must be verified in SES console before use)
# SENDER_EMAIL=no-reply@example.com
